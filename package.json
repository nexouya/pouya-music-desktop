{
  "name": "pouya-music",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js dist-electron",
    "lint": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-electron/main.cjs && cp electron/preload.cjs dist-electron/preload.cjs",
    "electron:dev": "npm run build:electron && electron .",
    "dist:win": "npm run tauri:build",
    "dist:mac": "npm run tauri:build",
    "dist:linux": "npm run tauri:build",
    "dist": "npm run tauri:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "jsmediatags": "^3.9.7",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "play-dl": "^1.9.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socks": "^2.8.9",
    "three": "^0.184.0",
    "undici": "^8.9.0",
    "vite": "^6.2.3",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsmediatags": "^3.9.6",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.pouya.music",
    "productName": "Pouya Music",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/yt-core/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
