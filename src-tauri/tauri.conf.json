{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pouya Music",
  "version": "1.0.0",
  "identifier": "com.pouya.music",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pouya Music",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#030712",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {},
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Music",
    "shortDescription": "High-fidelity spatial music player",
    "longDescription": "Pouya Music — native desktop client with Rust core playback, library, and streaming."
  },
  "plugins": {}
}
